<!DOCTYPE html>

<% if (config.language){ %>
<html lang="<%= config.language %>" >
<% } else { %>
<html lang="en">
<% }%>

<head>
  <meta charset="utf-8" />
  <% var title = page.title; if (is_archive()) { title = __('archive_a'); if
    (is_month()) { title += ': ' + page.year + '/' + page.month; } else if
    (is_year()) { title += ': ' + page.year; } } else if (is_category()) { title
    = page.category; } else if (is_tag()) {
    title = __('tag') + ': ' + page.tag; } %> <% if (page.keywords){ %>
  <meta name="keywords" content="<%= page.keywords %>,<%= config.keywords %>" />
  <% } else if (config.keywords){ %>
  <meta name="keywords" content="<%= config.keywords %>" />
  <% } %> <% if (page.description){ %>
  <meta name="description" content="<%= page.description %>" />
  <% } else if (config.description){ %>
  <meta name="description" content="<%= config.description %>" />
  <% } %>
  <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, viewport-fit=cover" />
  <title>
    <% if (title){ %><%= title %> | <% } %> <%= config.title %>
  </title>
  <% if (theme.favicon){ %>
  <%
    var faviconVersion = theme.favicon_version;
    var faviconSep = theme.favicon.indexOf('?') !== -1 ? '&' : '?';
  %>
  <link rel="shortcut icon" href="<%- theme.favicon %><%- (faviconVersion ? faviconSep + faviconVersion : '') %>" />
  <% } %>
  <%- css('dist/main') %>
  <%- css('css/custom') %>
  <% if (theme.progressBar){ %>
  <script src="https://cdn.jsdelivr.net/npm/pace-js@1.0.2/pace.min.js"></script>
  <% } %>
  <% if (theme.darkmode){ %>
  <%
    var darkAuto = true;
    var nightStart = 18;
    var nightEnd = 6;
    if (theme.darkmode_auto === false) {
      darkAuto = false;
    } else if (theme.darkmode_auto && typeof theme.darkmode_auto === 'object') {
      if (theme.darkmode_auto.enable === false) darkAuto = false;
      if (typeof theme.darkmode_auto.night_start === 'number') nightStart = theme.darkmode_auto.night_start;
      if (typeof theme.darkmode_auto.night_end === 'number') nightEnd = theme.darkmode_auto.night_end;
    }
  %>
  <script>
    window.AYER_DARKMODE = {
      auto: <%= darkAuto %>,
      nightStart: <%= nightStart %>,
      nightEnd: <%= nightEnd %>
    };
    (function () {
      var cfg = window.AYER_DARKMODE;
      var saved = null;
      try { saved = sessionStorage.getItem('darkmode'); } catch (e) {}
      function isNight() {
        var h = new Date().getHours();
        var start = cfg.nightStart;
        var end = cfg.nightEnd;
        if (start === end) return true;
        if (start > end) return h >= start || h < end;
        return h >= start && h < end;
      }
      var dark = saved === '1' || (saved !== '0' && cfg.auto && isNight());
      if (dark) {
        document.documentElement.classList.add('darkmode');
        document.addEventListener('DOMContentLoaded', function () {
          document.body.classList.add('darkmode');
        });
      }
    })();
  </script>
  <style>
    html.darkmode, html.darkmode body { background: #000; color: #fff; }
  </style>
  <% } %>
  <%- partial('google-analytics') %>
  <%- partial('baidu-analytics') %>
</head>

</html>